JWT_SECRET=changeme-super-secret-min-32-chars
# Local (default si se dejan vacias): mongodb://mongo:27017/<db>
# Atlas ejemplo:
# MONGODB_URI_AUTHDB=mongodb+srv://<DB_USER>:<DB_PASS>@<cluster>.mongodb.net/authdb?retryWrites=true&w=majority&appName=clusterPortafolio
MONGODB_URI_AUTHDB=
MONGODB_URI_HABITSDB=
MONGODB_URI_PLANNERDB=
# Solo para crear el admin inicial (seed). Dejar vacio en uso normal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# IP local donde se publica el gateway. En tu maquina Tailnet pon tu IP
# (ej. 100.119.13.70) para que solo la Tailnet llegue. Default: 127.0.0.1.
TAILNET_BIND_IP=127.0.0.1
# Puerto publico del gateway (interno siempre 8080). Cambialo si el 8080
# esta ocupado en tu maquina. Default: 8080.
GATEWAY_PORT=8080
# Allowlist admin (IPs o CIDR separados por coma). Default: toda la Tailnet.
ADMIN_TAILNET_IPS=100.64.0.0/10
